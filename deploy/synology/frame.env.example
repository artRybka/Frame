# Copy to frame.env next to docker-compose.yml and fill in.
# Panel address, PIN and MAC: also settable in the app (Ramka → Połączenie z
# ekranem); values saved there win over these.
FRAME_DEVICE_HOST=192.168.1.50
FRAME_DEVICE_PIN=000000
FRAME_DEVICE_MAC=
FRAME_PORT=8099
# NAS address as seen by the panel, bare IP or name, e.g. 192.168.1.10
# (autodetected when empty)
FRAME_PUBLIC_HOST=
FRAME_API_TOKEN=change-me
# Built-in palette name or path inside the container, e.g. /data/palette.json
FRAME_PALETTE=
# Disk space for originals the server can download again (museums, shared
# albums), in MB; the least recently used ones are deleted beyond it, those in
# Favourites and playlists last (your uploads are always kept and not counted)
FRAME_IMAGE_CACHE_MB=3000
# Disk space for the catalogue browsed in the app (museum works with thumbnails
# and colours, grown in the background), in MB; 0 turns the growing off
# Both limits can be set in the app (Ramka → gear → Konfiguracja), which wins.
FRAME_CATALOGUE_MB=1000
# Europeana API key (free at https://pro.europeana.eu/page/get-api); the shared
# demo key is used when empty
FRAME_EUROPEANA_KEY=
# Openverse app credentials for more than 200 searches a day (optional)
FRAME_OPENVERSE_CLIENT_ID=
FRAME_OPENVERSE_CLIENT_SECRET=
# Anthropic API key for keywords and Polish texts from Claude (optional);
# usually entered in the app (Ramka → gear → Konfiguracja), which wins over this
FRAME_ANTHROPIC_API_KEY=
