# Copy to frame.env next to docker-compose.yml and fill in.
FRAME_DEVICE_HOST=192.168.1.50
FRAME_DEVICE_PIN=000000
FRAME_DEVICE_MAC=
FRAME_PORT=8099
# NAS address as seen by the panel, bare IP or name, e.g. 192.168.1.10
# (autodetected when empty)
FRAME_PUBLIC_HOST=
FRAME_API_TOKEN=change-me
# Built-in palette name or path inside the container, e.g. /data/palette.json
FRAME_PALETTE=
# Disk space for downloaded museum originals, in MB; the least recently used
# ones are deleted beyond it (your uploads and photos are always kept)
FRAME_IMAGE_CACHE_MB=500
