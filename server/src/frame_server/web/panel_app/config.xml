<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://frame.home/frame" version="1.0.0" viewmodes="maximized">
    <tizen:application id="FrmFrame01.Frame" package="FrmFrame01" required_version="6.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>Frame</name>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data:</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/systemcontrol"/>
    <!-- webapis.network: the Wi-Fi's signal, SSID, address and frequency. -->
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <!-- webapis.timer.setCurrentTime: its clock stood at 2024-01-01 and the
         panel's alarms go by it (E18, 2026-11-04). -->
    <tizen:privilege name="http://developer.samsung.com/privilege/devicetimer"/>
    <!-- Test (PLAN 2.6j, E19): after a cold boot the launcher never starts
         the app. Tizen's alarm manager may (tizen.alarm with the app's id,
         app.js launchAlarms), and Samsung's prelaunch, which the VXT Player
         declares, may load it at boot. -->
    <tizen:privilege name="http://tizen.org/privilege/alarm"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/application/epaper.support" value="true"/>
    <!-- A 2560x1440 page, so pictures are shown 1:1 (without it 1920x1080, E16). -->
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="always"/>
    <!-- Test (PLAN 2.6r): every start of the app drew a launch screen first
         (navy, a spinner or an icon) and the picture only after it, two
         refreshes of the e-paper per change (camera, 2026-11-06). A launch
         screen of our own, fully transparent, kept until window.screen.show()
         (app.js reveal(), once the picture is on the page): the panel may
         keep the old picture until then and refresh once. -->
    <tizen:launch_screen ready_when="custom">
        <tizen:ls_default background_image="blank.png" image="blank.png" image_border="0px stretch"/>
    </tizen:launch_screen>
    <tizen:profile name="tv-samsung"/>
    <!-- background-support: with "disable" Tizen stops the page's JS whenever
         the launcher puts it in the background (around a sleep), and after a
         wake it stood still until brought to the front (2026-10-30). The
         WakeProbe of E16, which a magic packet resumed in 2 s, had "enable". -->
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
