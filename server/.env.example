# Copy to .env and fill in. Environment variables override this file.

# Panel (Samsung EM32DX)
FRAME_DEVICE_HOST=192.168.1.50
FRAME_DEVICE_PIN=000000
# Needed for Wake-on-LAN
FRAME_DEVICE_MAC=

# HTTP server the panel downloads from
FRAME_PORT=8099
# Address of this machine as seen by the panel (autodetected when empty)
FRAME_PUBLIC_HOST=
# Bearer token for /api/* (optional during development)
FRAME_API_TOKEN=

FRAME_DATA_DIR=data
# Built-in palette name or path to a calibrated palette JSON
FRAME_PALETTE=
